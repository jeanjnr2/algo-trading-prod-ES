#!/bin/sh
set -eu

CONTROL="${ALGO_CONTROL_FILE:-/app/control/v8_es.json}"
CMD="${1:-status}"

write_json() {
  tmp="${CONTROL}.tmp"
  jq "$1" "$CONTROL" > "$tmp"
  mv "$tmp" "$CONTROL"
}

need_value() {
  if [ $# -lt 2 ]; then
    echo "Missing value for $1"
    exit 1
  fi
}

need_int() {
  need_value "$1" "${2:-}"
  case "$2" in
    ''|*[!0-9]*)
      echo "$1 must be a positive integer"
      exit 1
      ;;
  esac
}

need_number() {
  need_value "$1" "${2:-}"
  case "$2" in
    ''|*[!0-9.]*|*.*.*)
      echo "$1 must be a number"
      exit 1
      ;;
  esac
}

case "$CMD" in
  pause)
    write_json '.allow_new_entries=false | .flatten_now=false'
    echo "V8_ES paused"
    ;;
  resume)
    write_json '.allow_new_entries=true | .flatten_now=false | .stop_after_flat=false'
    echo "V8_ES resumed"
    ;;
  stopflat)
    write_json '.allow_new_entries=false | .stop_after_flat=true'
    echo "V8_ES will stop after flat"
    ;;
  flatten)
    write_json '.allow_new_entries=false | .flatten_now=true'
    echo "V8_ES flatten requested"
    ;;
  contracts)
    need_int "$CMD" "${2:-}"
    write_json ".contracts=$2"
    echo "V8_ES contracts set to $2"
    ;;
  max)
    need_int "$CMD" "${2:-}"
    write_json ".max_contracts=$2"
    echo "V8_ES max_contracts set to $2"
    ;;
  autosizing)
    need_value "$CMD" "${2:-}"
    case "$2" in
      on|true|1)
        write_json '.enable_auto_sizing=true'
        echo "V8_ES auto sizing enabled"
        ;;
      off|false|0)
        write_json '.enable_auto_sizing=false'
        echo "V8_ES auto sizing disabled"
        ;;
      *)
        echo "Usage: algoctl autosizing on|off"
        exit 1
        ;;
    esac
    ;;
  rmultiple)
    need_number "$CMD" "${2:-}"
    write_json ".sizing_r_multiple=$2"
    echo "V8_ES sizing_r_multiple set to $2"
    ;;
  risk)
    jq '{contracts, enable_auto_sizing, sizing_r_multiple, max_contracts}' "$CONTROL"
    ;;
  status)
    cat "$CONTROL"
    ;;
  *)
    echo "Usage: algoctl pause|resume|stopflat|flatten|contracts N|max N|autosizing on|off|rmultiple N|risk|status"
    exit 1
    ;;
esac
